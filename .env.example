# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# a real value. ".env" is gitignored - never commit your actual auth key.
#
# Generate one at https://login.tailscale.com/admin/settings/keys
# "Generate auth key...". A reusable key means this container can
# re-auth itself if the state volume is ever wiped, without you having to
# come back and paste in a new key - recommended for a server like this.
# Leave "Ephemeral" OFF so the node doesn't get removed from your tailnet
# when the container restarts.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
